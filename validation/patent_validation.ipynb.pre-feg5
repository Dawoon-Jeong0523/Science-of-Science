   "cell_type": "code",
   "execution_count": null,
   "id": "d271d89c",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%time\n",
    "zc = pd.read_parquet(os.path.join(POUT, 'patent_z_score.parquet'), columns=['patent_id', 'Z_median', 'Z_10pct'])\n",
    "zc = zc.merge(df[['patent_id', 'pctl_uniqueC_5']], on='patent_id', how='inner')\n",
    "hitp = (zc['pctl_uniqueC_5'] >= 0.95).astype(float).values\n",
    "plot_2x2(zc['Z_median'].values, zc['Z_10pct'].values, hitp, 'Patent atypicality (Kim et al. 2016, CPC) 2x2 (hit = top 5% C5)')"
   ]
