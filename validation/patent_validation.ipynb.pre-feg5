    "ax[1].set_title(f'Per-patent delta convexity index (extended - granted), mean {dd.mean():+.3f}'); ax[1].set_xlabel('delta convexity index')\n",
    "byse = per_e.dropna(subset=['cpc_section']).groupby('cpc_section').agg(\n",
