   "source": [
    "## 4. Forward-citation (UNIQUE / de-duplicated) distributions + windowed monotonicity"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "d61b1a9f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  [fig] patent_validation_4.jpg + .pdf  (600 dpi)\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1430x440 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "uniqueC_3<=uniqueC_5<=uniqueC_10<=uniqueC_all violations: 0.0000%  (should be 0)\n"
     ]
    }
   ],
   "source": [
    "fig, ax = plt.subplots(1, 2, figsize=(13, 4))\n",
    "for c, col in zip(['uniqueC_3', 'uniqueC_5', 'uniqueC_10', 'uniqueC_all'], ['#4c72b0', '#55a868', '#c44e52', '#8172b3']):\n",
    "    v = df[c][df[c] > 0]\n",
    "    ax[0].hist(np.log10(v + 1), bins=60, histtype='step', label=c, color=col, linewidth=1.5)\n",
    "ax[0].set_title('Citation counts (log10, cited only)'); ax[0].set_xlabel('log10(citations+1)'); ax[0].legend()\n",
    "# monotonicity: uniqueC_3<=uniqueC_5<=uniqueC_10<=uniqueC_all should always hold\n",
    "viol = ((df['uniqueC_3'] > df['uniqueC_5']) | (df['uniqueC_5'] > df['uniqueC_10']) | (df['uniqueC_10'] > df['uniqueC_all'])).mean() * 100\n",
    "means = df[['uniqueC_3', 'uniqueC_5', 'uniqueC_10', 'uniqueC_all']].mean()\n",
    "means.plot.bar(ax=ax[1], color=['#4c72b0', '#55a868', '#c44e52', '#8172b3'])\n",
    "ax[1].set_title(f'Mean citations by window (monotonicity violations: {viol:.3f}%)')\n",
    "ax[1].set_ylabel('mean'); plt.setp(ax[1].get_xticklabels(), rotation=0)\n",
    "plt.tight_layout(); V.save('4')\n",
    "print(f'uniqueC_3<=uniqueC_5<=uniqueC_10<=uniqueC_all violations: {viol:.4f}%  (should be 0)')"
   ]
  },
