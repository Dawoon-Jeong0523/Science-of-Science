    "ax[2].plot(GX, overall, color=RED, ls='--', lw=2, label=f'all hit-1%  AUC={aucc(overall):.3f}')\n",
    "ax[2].plot(GX, hitraj, color=RED, lw=2.5, label=f'high-SB (top10%)  AUC={aucc(hitraj):.3f}')\n",
    "ax[2].plot([0, 1], [0, 1], color='gray', ls=':', lw=1); ax[2].set_title('Sleeping beauties more convex')\n",
