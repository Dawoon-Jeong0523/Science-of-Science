    "## 3. Atypicality 2×2 — hit-paper probability (Uzzi et al.)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "14a3daab",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T20:05:07.312026Z",
     "iopub.status.busy": "2026-08-28T20:05:07.312026Z",
