   "source": [
    "## 3. Atypicality 2×2 — hit-paper probability (Uzzi et al.)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "14a3daab",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-31T22:53:33.089900Z",
     "iopub.status.busy": "2026-08-31T22:53:33.089693Z",
     "iopub.status.idle": "2026-08-31T22:53:33.096426Z",
     "shell.execute_reply": "2026-08-31T22:53:33.095953Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "paper_z_score.parquet not present yet -> run paper_z_score, then re-run this cell.\n",
      "CPU times: user 58 μs, sys: 5 μs, total: 63 μs\n",
      "Wall time: 62.5 μs\n"
     ]
    }
   ],
   "source": [
    "%%time\n",
    "if not HAS_Z:\n",
    "    print('paper_z_score.parquet not present yet -> run paper_z_score, then re-run this cell.')\n",
    "else:\n",
    "    # median conventionality = Z_median ; tail novelty = low Z_10pct (more negative = more novel).\n",
    "    # hit = top 5% by citations within cohort (pctl_call >= 0.95). Split each axis at its median.\n",
    "    q = f'''\n",
    "    SELECT z.Z_median, z.Z_10pct, h.pctl_call\n",
    "    FROM read_parquet('{ZS}') z JOIN read_parquet('{HIT}') h USING (paper_id)\n",
    "    WHERE z.Z_median IS NOT NULL AND z.Z_10pct IS NOT NULL AND h.pctl_call IS NOT NULL\n",
    "    '''\n",
    "    d = con.execute(q).fetchdf()\n",
    "    med_conv = d['Z_median'].median(); med_nov = d['Z_10pct'].median()\n",
    "    hi_conv = d['Z_median'] >= med_conv                 # high median conventionality\n",
    "    hi_nov = d['Z_10pct'] <= med_nov                    # high tail novelty (lower Z = more novel)\n",
    "    hit = d['pctl_call'] >= 0.95\n",
    "    cells = {('LowConv', 'LowNov'): (~hi_conv) & (~hi_nov), ('LowConv', 'HighNov'): (~hi_conv) & hi_nov,\n",
    "             ('HighConv', 'LowNov'): hi_conv & (~hi_nov), ('HighConv', 'HighNov'): hi_conv & hi_nov}\n",
    "    P4 = {k: hit[v].mean() for k, v in cells.items()}\n",
    "    print('hit probability per cell:', {f'{a}|{b}': round(p, 4) for (a, b), p in P4.items()})\n",
    "    # 3D bars: x = novelty (low,high), y = convention (low,high)\n",
    "    from mpl_toolkits.mplot3d import Axes3D  # noqa\n",
    "    fig = plt.figure(figsize=(9, 6)); ax = fig.add_subplot(projection='3d')\n",
    "    xpos = np.array([0, 1, 0, 1]); ypos = np.array([0, 0, 1, 1]); zpos = np.zeros(4)\n",
    "    dz = [P4[('LowConv', 'LowNov')], P4[('LowConv', 'HighNov')], P4[('HighConv', 'LowNov')], P4[('HighConv', 'HighNov')]]\n",
    "    ax.bar3d(xpos, ypos, zpos, 0.6, 0.6, dz, color=['red', 'orange', 'green', 'blue'], zsort='average')\n",
    "    ax.set_xticks([0.3, 1.3]); ax.set_xticklabels(['Low Tail\\nNovelty', 'High Tail\\nNovelty'], fontsize=9)\n",
    "    ax.set_yticks([0.3, 1.3]); ax.set_yticklabels(['Low Median\\nConvention', 'High Median\\nConvention'], fontsize=9)\n",
    "    ax.set_zlabel('Hit paper probability', fontsize=13); ax.view_init(20, -45)\n",
    "    for pane in (ax.xaxis, ax.yaxis, ax.zaxis): pane.pane.fill = False\n",
    "    V.save('3')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cff85f94",
   "metadata": {},
   "source": [
    "## 3b. Atypicality 2x2 - SciSciNet atypicality (Atyp_Median_Z x Atyp_10pct_Z)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "f4e8208a",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-31T22:53:33.097770Z",
     "iopub.status.busy": "2026-08-31T22:53:33.097604Z",
     "iopub.status.idle": "2026-08-31T22:53:33.103250Z",
     "shell.execute_reply": "2026-08-31T22:53:33.102775Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "CPU times: user 14 μs, sys: 1e+03 ns, total: 15 μs\n",
      "Wall time: 18.8 μs\n"
     ]
    }
   ],
   "source": [
    "%%time\n",
    "from mpl_toolkits.mplot3d import Axes3D  # noqa\n",
    "\n",
    "def plot_2x2(zmed, znov, hit, title, zlabel='Hit paper probability'):\n",
    "    # zmed = median conventionality (higher = more conventional); znov = tail novelty score (LOWER = more novel)\n",
    "    zmed = np.asarray(zmed, float); znov = np.asarray(znov, float); hit = np.asarray(hit, float)\n",
    "    m = np.isfinite(zmed) & np.isfinite(znov) & np.isfinite(hit)\n",
    "    zmed, znov, hit = zmed[m], znov[m], hit[m]\n",
    "    hc = zmed >= np.median(zmed)            # high median conventionality\n",
    "    hn = znov <= np.median(znov)            # high tail novelty (lower Z = more novel)\n",
    "    cells = {('LowConv', 'LowNov'): (~hc) & (~hn), ('LowConv', 'HighNov'): (~hc) & hn,\n",
    "             ('HighConv', 'LowNov'): hc & (~hn), ('HighConv', 'HighNov'): hc & hn}\n",
    "    P4 = {k: hit[v].mean() for k, v in cells.items()}\n",
    "    fig = plt.figure(figsize=(9, 6)); ax = fig.add_subplot(projection='3d')\n",
    "    xpos = np.array([0, 1, 0, 1]); ypos = np.array([0, 0, 1, 1]); zpos = np.zeros(4)\n",
    "    dz = [P4[('LowConv', 'LowNov')], P4[('LowConv', 'HighNov')], P4[('HighConv', 'LowNov')], P4[('HighConv', 'HighNov')]]\n",
    "    ax.bar3d(xpos, ypos, zpos, 0.6, 0.6, dz, color=['red', 'orange', 'green', 'blue'], zsort='average')\n",
    "    ax.set_xticks([0.3, 1.3]); ax.set_xticklabels(['Low Tail\\nNovelty', 'High Tail\\nNovelty'], fontsize=9)\n",
    "    ax.set_yticks([0.3, 1.3]); ax.set_yticklabels(['Low Median\\nConvention', 'High Median\\nConvention'], fontsize=9)\n",
    "    ax.set_zlabel(zlabel, fontsize=12); ax.set_title(title, fontsize=11); ax.view_init(20, -45)\n",
    "    for pane in (ax.xaxis, ax.yaxis, ax.zaxis): pane.pane.fill = False\n",
    "    plt.tight_layout(); V.save('3b')\n",
    "    print(title, '-> hit prob per cell:', {f'{a}|{b}': round(p, 4) for (a, b), p in P4.items()})"
   ]
  },
