   ],
   "source": [
    "pct_convex = (per['cvx'] < 0.5).mean() * 100\n",
    "byf = per.dropna(subset=['FoS']).groupby('FoS').agg(\n",
    "    mean_cvx=('cvx', 'mean'), pct_convex=('cvx', lambda x: (x < 0.5).mean() * 100), n=('cvx', 'size'))\n",
    "byf = byf[byf['n'] >= 30].sort_values('mean_cvx')\n",
    "fig, ax = plt.subplots(figsize=(9, 6))\n",
    "colors = ['#d62728' if a < 0.5 else '#1f77b4' for a in byf['mean_cvx']]\n",
    "ax.barh(range(len(byf)), byf['mean_cvx'], color=colors)\n",
    "ax.set_yticks(range(len(byf))); ax.set_yticklabels(byf.index, fontsize=8)\n",
    "ax.axvline(0.5, color='k', ls='--'); ax.set_xlabel('mean convexity index')\n",
    "ax.set_title('Hit top-1% papers: mean convexity index by field (red convex / blue concave)')\n",
    "plt.tight_layout(); V.save('6b')\n",
    "print('overall (hit top-1%):', {'convex%': round(pct_convex, 1), 'concave%': round(100 - pct_convex, 1), 'mean_cvx': round(per.cvx.mean(), 3)})\n",
    "print('\\\\nconvex vs concave group properties:')\n",
    "print(per.groupby('shape').agg(n=('cvx', 'size'), mean_cvx=('cvx', 'mean'),\n",
    "      mean_citations=('tot', 'mean'), mean_SB_B=('SB_B', 'mean')).round(2).to_string())\n",
    "print('\\\\nmean convexity index / %convex by field:'); display(byf.round(3))\n",
    "sp = pd.DataFrame({'sb': per['SB_B'], 'cvx': per['cvx']}).replace([np.inf, -np.inf], np.nan).dropna()\n",
    "print(f'Spearman(SB_B, convexity index) = {sp.sb.rank().corr(sp.cvx.rank()):+.3f}  (negative = higher SB -> more convex)')\n",
    "print('done — paper hit-top-1% convexity analysis rendered inline.')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d3119927",
   "metadata": {},
   "source": [
    "## 7. Yearly-trend convexity — Disruption / F / E / G / ni / nj / nk (overall & by FoS)\n",
    "\n",
    "Same min–max + convexity-index test applied to the **time trend** of each metric (mean value by publication year):\n",
    "`<0.5` **convex** (accelerating / late upturn), `>0.5` **concave** (early rise then flattening). Computed\n",
    "overall and per **FoS level-0** field, from `paper_disruption` ⋈ `paper_metadata` (truncation-safe range)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "de161e9d",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-31T23:09:34.797770Z",
     "iopub.status.busy": "2026-08-31T23:09:34.797548Z",
     "iopub.status.idle": "2026-08-31T23:10:02.142584Z",
     "shell.execute_reply": "2026-08-31T23:10:02.141981Z"
    }
   },
   "outputs": [
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "726190a851cd4b10834e85e6af005c9a",
       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "FloatProgress(value=0.0, layout=Layout(width='auto'), style=ProgressStyle(bar_color='black'))"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "39f38bb8e89a4a1a9a83dac3cde03bb2",
       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "FloatProgress(value=0.0, layout=Layout(width='auto'), style=ProgressStyle(bar_color='black'))"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "overall yearly-trend convexity index per metric (1950-2010; <0.5 convex / >0.5 concave):\n",
      "  CD_5     convexity index 0.458  (convex)\n",
      "  F_5      convexity index 0.535  (concave)\n",
      "  E_5      convexity index 0.574  (concave)\n",
      "  G_5      convexity index 0.395  (convex)\n",
      "  ni_5     convexity index 0.446  (convex)\n",
      "  nj_5     convexity index 0.400  (convex)\n",
      "  nk_5     convexity index 0.304  (convex)\n",
      "CPU times: user 2min 23s, sys: 22 s, total: 2min 45s\n",
      "Wall time: 27.3 s\n"
     ]
    }
   ],
   "source": [
    "%%time\n",
    "METR = ['CD_5', 'F_5', 'E_5', 'G_5', 'ni_5', 'nj_5', 'nk_5']\n",
    "YR0, YR1 = 1950, 2010\n",
    "avgs = ', '.join([f'avg(d.{m}) {m}' for m in METR])\n",
    "ov = con.execute(f'''SELECT m.year AS yr, {avgs}\n",
    "  FROM read_parquet('{DISR}') d JOIN read_parquet('{META}') m USING (paper_id)\n",
    "  WHERE d.CD_5 IS NOT NULL AND m.year BETWEEN {YR0} AND {YR1}\n",
    "  GROUP BY yr ORDER BY yr''').fetchdf()\n",
    "byf = con.execute(f'''SELECT m.year AS yr, coalesce(m.FoS_rep, split_part(m.FoS_0,';',1)) AS fos, count(*) n, {avgs}\n",
    "  FROM read_parquet('{DISR}') d JOIN read_parquet('{META}') m USING (paper_id)\n",
    "  WHERE d.CD_5 IS NOT NULL AND m.year BETWEEN {YR0} AND {YR1}\n",
    "        AND coalesce(m.FoS_rep, split_part(m.FoS_0,';',1)) IS NOT NULL\n",
    "  GROUP BY yr, fos ORDER BY fos, yr''').fetchdf()\n",
    "\n",
    "def trend_cvx(t, y):\n",
    "    t = np.asarray(t, float); y = np.asarray(y, float); ok = np.isfinite(y)\n",
    "    t, y = t[ok], y[ok]\n",
    "    if len(y) < 6 or y.max() == y.min(): return np.nan\n",
    "    tn = (t - t.min()) / (t.max() - t.min()); yn = (y - y.min()) / (y.max() - y.min())\n",
    "    return float(np.trapz(yn, tn))\n",
    "\n",
    "print(f'overall yearly-trend convexity index per metric ({YR0}-{YR1}; <0.5 convex / >0.5 concave):')\n",
    "for m in METR:\n",
    "    a = trend_cvx(ov['yr'].values, ov[m].values)\n",
    "    print(f'  {m:8s} convexity index {a:.3f}  ({\"convex\" if a < 0.5 else \"concave\"})')"
   ]
  },
