  1       NaN     NaN   \n", "1        6                 0                     6       NaN     NaN   \n", "2       10                 0                    10  Medicine  1999.0   \n", "\n", "    pctl_c3   pctl_c5  pctl_c10  pctl_call  \n", "0       NaN       NaN       NaN        NaN  \n", "1       NaN       NaN       NaN        NaN  \n", "2  0.000034  0.000034  0.494078   0.817814  \n", "\n", "[3 rows x 22 columns]"]}, "execution_count": 2, "metadata": {}, "output_type": "execute_result"}], "source": ["%%time\n", "cit = pd.read_parquet(os.path.join(POUT, 'pcs_citation.parquet'))\n", "hit = pd.read_parquet(os.path.join(POUT, 'pcs_hit_probability.parquet'))\n", "df = cit.merge(hit, on='paper_id', how='left')\n", "print('rows:', {'cit': len(cit), 'hit': len(hit), 'merged': len(df)}); print('cols:', list(df.columns))\n", "df.head(3)"]}, {"cell_type": "code", "execution_count": 7, "id": "2be53517-e80b-48ac-8449-a6a8b91fb2bb", "metadata": {}, "outputs": [{"data": {"text/html": ["<div>\n", "<style scoped>\n", "    .dataframe tbody tr th:only-of-type {\n", "        vertical-align: middle;\n", "    }\n", "\n", "    .dataframe tbody tr th {\n", "        vertical-align: top;\n", "    }\n", "\n", "    .dataframe thead th {\n", "        text-align: right;\n", "    }\n", "</style>\n", "<table border=\"1\" class=\"dataframe\">\n", "  <thead>\n", "    <tr style=\"text-align: right;\">\n", "      <th></th>\n", "      <th>paper_id</th>\n", "      <th>C_3</th>\n", "      <th>C_5</th>\n", "      <th>C_10</th>\n", "      <th>C_all</th>\n", "      <th>C_examiner_3</th>\n", "      <th>C_non_examiner_3</th>\n", "      <th>C_examiner_5</th>\n", "      <th>C_non_examiner_5</th>\n", "      <th>C_examiner_10</th>\n", "      <th>C_non_examiner_10</th>\n", "      <th>C_examiner_all</th>\n", "      <th>C_non_examiner_all</th>\n", "      <th>C_total</th>\n", "      <th>C_examiner_total</th>\n", "      <th>C_non_examiner_total</th>\n", "    </tr>\n", "  </thead>\n", "  <tbody>\n", "    <tr>\n", "   