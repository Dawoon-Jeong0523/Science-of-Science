       "      granted  extended   delta\n",
       "_3     0.0933    0.0618 -0.0315\n",
       "_5     0.1240    0.0817 -0.0423\n",
       "_10    0.1517    0.1020 -0.0497\n",
       "_all   0.1691    0.1173 -0.0518"
