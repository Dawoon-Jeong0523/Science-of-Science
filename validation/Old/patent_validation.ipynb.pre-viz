    "ax[2].scatter(np.log10(s['SB_B'].clip(lower=0) + 1), np.log10(s['uniqueC_5'] + 1), s=3, alpha=0.15, color='teal')\n",
    "ax[2].set_xlabel('log10(SB_B+1)'); ax[2].set_ylabel('log10(uniqueC_5+1)'); ax[2].set_title('B vs eventual citations')\n",
