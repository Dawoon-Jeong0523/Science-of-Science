   "source": [
    "import os, sys\n",
    "import numpy as np, pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "%matplotlib inline\n",
    "plt.rcParams['figure.dpi'] = 110; plt.rcParams['axes.grid'] = True; plt.rcParams['grid.alpha'] = 0.3\n",
    "sys.path.insert(0, '/project/jevans/Dawoon/Science of Science/validation')\n",
    "import val_common as V\n",
    "V.init('ppp_validation')\n",
    "PO = V.PPP_OUT                 # notebook/PPP/output -> Science of Science/PPP/output\n",
    "ROOT = V.BASE\n",
    "V.preflight()\n",
    "PAPER_FP = os.path.join(PO, 'ppp_paper_trend.parquet'); PAT_FP = os.path.join(PO, 'ppp_patent_trend.parquet')\n",
    "HAS = os.path.exists(PAPER_FP) and os.path.exists(PAT_FP)\n",
    "print('PPP outputs present:', HAS)"
   ]
  },
  {
