   "source": [
    "%%time\n",
    "assert HAS, 'run notebook/PPP/ppp_citation_trend.ipynb first to produce the trend parquets.'\n",
    "pt = pd.read_parquet(PAPER_FP); qt = pd.read_parquet(PAT_FP)\n",
    "n_pairs_paper = pt[['paperid', 'patent']].drop_duplicates().shape[0]\n",
    "n_pairs_pat = qt[['paperid', 'patent']].drop_duplicates().shape[0]\n",
    "print(f'paper-side rows {len(pt):,} over {n_pairs_paper:,} pairs | patent-side rows {len(qt):,} over {n_pairs_pat:,} pairs')\n",
    "print('paper-side cols:', list(pt.columns)); print('patent-side cols:', list(qt.columns))\n",
    "display(pt.head(4)); display(qt.head(4))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5c13292c",
   "metadata": {},
   "source": [
    "## 2. Citation-age profiles (per-pair average vs years since publication / grant)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "48fe199e",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T17:28:34.403552Z",
     "iopub.status.busy": "2026-08-28T17:28:34.403552Z",
     "iopub.status.idle": "2026-08-28T17:28:34.828576Z",
     "shell.execute_reply": "2026-08-28T17:28:34.828576Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1540x495 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fig, ax = plt.subplots(1, 2, figsize=(14, 4.5))\n",
    "# paper side: average per pair at each offset = sum over rows / #pairs\n",
    "mp = pt[pt['yrs_since_pub'].between(0, 30)]\n",
    "prof = mp.groupby('yrs_since_pub')[['p2p', 'pat2p_examiner', 'pat2p_non_examiner']].sum() / n_pairs_paper\n",
    "prof['p2p'].plot(ax=ax[0], color='#4E2A84', lw=2, label='paper→paper (p2p)')\n",
    "(prof['pat2p_examiner'] + prof['pat2p_non_examiner']).plot(ax=ax[0], color='#F7602A', lw=2, label='patent→paper (pat2p)')\n",
    "ax[0].set_title('Paper-side citation-age profile'); ax[0].set_xlabel('years since publication')\n",
    "ax[0].set_ylabel('mean citations / pair / year'); ax[0].legend()\n",
    "# patent side\n",
    "mq = qt[qt['yrs_since_grant'].between(0, 30)]\n",
    "profq = mq.groupby('yrs_since_grant')[['pat2pat_examiner', 'pat2pat_non_examiner']].sum() / n_pairs_pat\n",
    "profq['pat2pat_examiner'].plot(ax=ax[1], color='#4c72b0', lw=2, label='pat2pat examiner')\n",
    "profq['pat2pat_non_examiner'].plot(ax=ax[1], color='#dd8452', lw=2, label='pat2pat non-examiner')\n",
    "(profq['pat2pat_examiner'] + profq['pat2pat_non_examiner']).plot(ax=ax[1], color='k', lw=1.2, ls='--', label='pat2pat total')\n",
    "ax[1].set_title('Patent-side citation-age profile'); ax[1].set_xlabel('years since grant')\n",
    "ax[1].set_ylabel('mean citations / pair / year'); ax[1].legend()\n",
    "plt.tight_layout(); V.save('2')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "64a8d1b4",
   "metadata": {},
   "source": [
    "## 3. Per-pair citation totals (distribution) + examiner/non-examiner share"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "efa132cd",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T17:28:34.829579Z",
     "iopub.status.busy": "2026-08-28T17:28:34.829579Z",
     "iopub.status.idle": "2026-08-28T17:28:36.258226Z",
     "shell.execute_reply": "2026-08-28T17:28:36.257717Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1540x495 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "per-pair means: p2p 95.04 | pat2p 18.10 | pat2pat 22.89\n"
     ]
    }
   ],
   "source": [
    "tot_p = pt.groupby(['paperid', 'patent']).agg(\n",
    "    p2p=('p2p', 'sum'), pat2p_exm=('pat2p_examiner', 'sum'), pat2p_nex=('pat2p_non_examiner', 'sum')).reset_index()\n",
    "tot_q = qt.groupby(['paperid', 'patent']).agg(\n",
    "    pat2pat_exm=('pat2pat_examiner', 'sum'), pat2pat_nex=('pat2pat_non_examiner', 'sum')).reset_index()\n",
    "fig, ax = plt.subplots(1, 2, figsize=(14, 4.5))\n",
    "for col, lab, cc in [(tot_p['p2p'], 'p2p', '#4E2A84'),\n",
    "                     (tot_p['pat2p_exm'] + tot_p['pat2p_nex'], 'pat2p', '#F7602A'),\n",
    "                     (tot_q['pat2pat_exm'] + tot_q['pat2pat_nex'], 'pat2pat', '#55a868')]:\n",
    "    v = col[col > 0]\n",
    "    ax[0].hist(np.log10(v + 1), bins=50, histtype='step', label=lab, color=cc, linewidth=1.5)\n",
    "ax[0].set_title('Per-pair total citations (log10, nonzero)'); ax[0].set_xlabel('log10(total+1)'); ax[0].legend()\n",
    "shares = pd.Series({\n",
    "    'pat2p': tot_p['pat2p_exm'].sum() / max(tot_p['pat2p_exm'].sum() + tot_p['pat2p_nex'].sum(), 1),\n",
    "    'pat2pat': tot_q['pat2pat_exm'].sum() / max(tot_q['pat2pat_exm'].sum() + tot_q['pat2pat_nex'].sum(), 1),\n",
    "})\n",
    "(shares * 100).plot.bar(ax=ax[1], color=['#F7602A', '#55a868'])\n",
    "ax[1].set_title('Examiner share of citations (%)'); ax[1].set_ylabel('% examiner'); plt.setp(ax[1].get_xticklabels(), rotation=0)\n",
    "for i, v in enumerate(shares.values): ax[1].text(i, v * 100 + 1, f'{v*100:.1f}%', ha='center', fontsize=9)\n",
    "plt.tight_layout(); V.save('3')\n",
    "print('per-pair means: p2p %.2f | pat2p %.2f | pat2pat %.2f' % (\n",
    "    tot_p['p2p'].mean(), (tot_p['pat2p_exm'] + tot_p['pat2p_nex']).mean(),\n",
    "    (tot_q['pat2pat_exm'] + tot_q['pat2pat_nex']).mean()))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7cd5a234",
   "metadata": {},
   "source": [
    "## 4. Scientific vs technological impact (p2p vs pat2p, per pair)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "8fc520eb",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T17:28:36.259230Z",
     "iopub.status.busy": "2026-08-28T17:28:36.259230Z",
     "iopub.status.idle": "2026-08-28T17:28:36.388194Z",
     "shell.execute_reply": "2026-08-28T17:28:36.388194Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 660x550 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "done — all PPP validation figures rendered inline.\n"
     ]
    }
   ],
   "source": [
    "s = tot_p.sample(min(60000, len(tot_p)), random_state=0)\n",
    "fig, ax = plt.subplots(figsize=(6, 5))\n",
    "ax.scatter(np.log10(s['p2p'] + 1), np.log10(s['pat2p_exm'] + s['pat2p_nex'] + 1), s=4, alpha=0.15, color='teal')\n",
    "ax.set_xlabel('log10(paper→paper citations + 1)'); ax.set_ylabel('log10(patent→paper citations + 1)')\n",
    "ax.set_title('Scientific vs technological impact (per pair)')\n",
    "r = np.corrcoef(np.log10(tot_p['p2p'] + 1), np.log10(tot_p['pat2p_exm'] + tot_p['pat2p_nex'] + 1))[0, 1]\n",
    "ax.text(0.05, 0.92, f'log-log r = {r:.3f}', transform=ax.transAxes, fontsize=11)\n",
    "plt.tight_layout(); V.save('4')\n",
    "print('done — all PPP validation figures rendered inline.')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3aa880d0",
   "metadata": {},
   "source": [
    "## 5. Cumulative citation trajectories — convexity vs concavity (min–max scaled)\n",
    "\n",
    "For each pair we build the **cumulative** citation curve and **min–max scale both axes to [0,1]**\n",
    "(x = normalized time, y = normalized cumulative citations), so shape is comparable across pairs:\n",
    "- **Paper trajectory** = paper→paper (`p2p`) cumulative by years since publication — **red**.\n",
    "- **Patent trajectory** = patent→patent (`pat2pat`) cumulative by years since grant — **blue**.\n",
    "\n",
    "A curve **below** the diagonal is **convex** (slow start, accelerating); **above** is **concave** (fast\n",
    "start, saturating). We quantify with the area under the normalized curve **AUC** (`<0.5` convex,\n",
    "`>0.5` concave). Hypothesis under test: paper convex, patent concave."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "3fe29176",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T17:28:36.390199Z",
     "iopub.status.busy": "2026-08-28T17:28:36.390199Z",
     "iopub.status.idle": "2026-08-28T17:34:18.775775Z",
     "shell.execute_reply": "2026-08-28T17:34:18.775775Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "pairs with sufficient signal on both sides (ALL used): 110,254\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "ALL 110,254 pairs | with FoS 99% | with CPC section 100%\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "trajectory pairs (both sides): 110,254  |  paper AUC 0.622  patent AUC 0.471\n",
      "CPU times: total: 5min 42s\n",
      "Wall time: 5min 42s\n"
     ]
    },
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "<timed exec>:42: DeprecationWarning: `trapz` is deprecated. Use `trapezoid` instead, or one of the numerical integration functions in `scipy.integrate`.\n"
     ]
    }
   ],
   "source": [
    "%%time\n",
    "RED, BLUE = '#d62728', '#1f77b4'\n",
    "GRID = np.linspace(0, 1, 21)\n",
    "MIN_TOTAL, MIN_SPAN = 10, 5\n",
    "qt['pat2pat'] = qt['pat2pat_examiner'] + qt['pat2pat_non_examiner']\n",
    "\n",
    "pp = pt.groupby(['paperid', 'patent']).agg(p2p_tot=('p2p', 'sum'), p2p_span=('yrs_since_pub', 'max')).reset_index()\n",
    "qq = qt.groupby(['paperid', 'patent']).agg(pat_tot=('pat2pat', 'sum'), pat_span=('yrs_since_grant', 'max')).reset_index()\n",
    "both = pp.merge(qq, on=['paperid', 'patent'])\n",
    "sel = both[(both.p2p_tot >= MIN_TOTAL) & (both.p2p_span >= MIN_SPAN) &\n",
    "           (both.pat_tot >= MIN_TOTAL) & (both.pat_span >= MIN_SPAN)].copy()\n",
    "print(f'pairs with sufficient signal on both sides (ALL used): {len(sel):,}')\n",
    "\n",
    "# attach paper FoS (level-0) + patent CPC section\n",
    "meta = pd.read_parquet(V.paper('paper_metadata.parquet'),\n",
    "                       columns=['paper_id', 'FoS_rep']).rename(columns={'paper_id': 'paperid'})\n",
    "sel = sel.merge(meta, on='paperid', how='left')\n",
    "pcpc = pd.read_parquet(V.patent('patent_metadata.parquet'),\n",
    "                       columns=['patent_id', 'cpc_code'])\n",
    "pcpc['cpc_section'] = pcpc['cpc_code'].str[0]\n",
    "sel['patent_id'] = sel['patent'].str.extract(r'[Uu][Ss]-0*([0-9]+)', expand=False)\n",
    "sel = sel.merge(pcpc[['patent_id', 'cpc_section']], on='patent_id', how='left')\n",
    "print(f'ALL {len(sel):,} pairs | with FoS {sel.FoS_rep.notna().mean()*100:.0f}% | with CPC section {sel.cpc_section.notna().mean()*100:.0f}%')\n",
    "\n",
    "def traj_matrix(df, keys_df, off, valcol):\n",
    "    sub = df.merge(keys_df[['paperid', 'patent']], on=['paperid', 'patent'], how='inner')\n",
    "    mats = {}\n",
    "    for k, g in sub.groupby(['paperid', 'patent']):\n",
    "        s = g.groupby(off)[valcol].sum().sort_index()\n",
    "        years = s.index.values.astype(float); cum = np.cumsum(s.values).astype(float)\n",
    "        if cum[-1] <= 0 or years[-1] <= 0: continue\n",
    "        xt = np.concatenate([[0.0], years / years[-1]]); yt = np.concatenate([[0.0], cum / cum[-1]])\n",
    "        mats[k] = np.interp(GRID, xt, yt)\n",
    "    return mats\n",
    "\n",
    "paper_mats = traj_matrix(pt, sel, 'yrs_since_pub', 'p2p')\n",
    "patent_mats = traj_matrix(qt, sel, 'yrs_since_grant', 'pat2pat')\n",
    "common = [k for k in paper_mats if k in patent_mats]\n",
    "PM = np.array([paper_mats[k] for k in common]); QM = np.array([patent_mats[k] for k in common])\n",
    "info = sel.set_index(['paperid', 'patent'])\n",
    "FoS_arr = info['FoS_rep'].reindex(common).values\n",
    "SEC_arr = info['cpc_section'].reindex(common).values\n",
    "def cvx(m): return np.trapz(m, GRID, axis=-1)\n",
    "print(f'trajectory pairs (both sides): {len(common):,}  |  '\n",
    "      f'paper convexity index {cvx(PM.mean(0)):.3f}  patent convexity index {cvx(QM.mean(0)):.3f}')"
   ]
  },
