    "## 19. Atypicality 2x2 - hit-patent probability (Youn CPC atypicality)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "761bd20c",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-31T22:56:36.174920Z",
     "iopub.status.busy": "2026-08-31T22:56:36.174780Z",
     "iopub.status.idle": "2026-08-31T22:56:36.180180Z",
     "shell.execute_reply": "2026-08-31T22:56:36.179773Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "CPU times: user 12 μs, sys: 0 ns, total: 12 μs\n",
      "Wall time: 15 μs\n"
     ]
    }
   ],
   "source": [
    "%%time\n",
    "from mpl_toolkits.mplot3d import Axes3D  # noqa\n",
    "\n",
    "def plot_2x2(zmed, znov, hit, title, zlabel='Hit paper probability'):\n",
    "    # zmed = median conventionality (higher = more conventional); znov = tail novelty score (LOWER = more novel)\n",
    "    zmed = np.asarray(zmed, float); znov = np.asarray(znov, float); hit = np.asarray(hit, float)\n",
    "    m = np.isfinite(zmed) & np.isfinite(znov) & np.isfinite(hit)\n",
    "    zmed, znov, hit = zmed[m], znov[m], hit[m]\n",
    "    hc = zmed >= np.median(zmed)            # high median conventionality\n",
    "    hn = znov <= np.median(znov)            # high tail novelty (lower Z = more novel)\n",
    "    cells = {('LowConv', 'LowNov'): (~hc) & (~hn), ('LowConv', 'HighNov'): (~hc) & hn,\n",
    "             ('HighConv', 'LowNov'): hc & (~hn), ('HighConv', 'HighNov'): hc & hn}\n",
    "    P4 = {k: hit[v].mean() for k, v in cells.items()}\n",
    "    fig = plt.figure(figsize=(9, 6)); ax = fig.add_subplot(projection='3d')\n",
    "    xpos = np.array([0, 1, 0, 1]); ypos = np.array([0, 0, 1, 1]); zpos = np.zeros(4)\n",
    "    dz = [P4[('LowConv', 'LowNov')], P4[('LowConv', 'HighNov')], P4[('HighConv', 'LowNov')], P4[('HighConv', 'HighNov')]]\n",
    "    ax.bar3d(xpos, ypos, zpos, 0.6, 0.6, dz, color=['red', 'orange', 'green', 'blue'], zsort='average')\n",
    "    ax.set_xticks([0.3, 1.3]); ax.set_xticklabels(['Low Tail\\nNovelty', 'High Tail\\nNovelty'], fontsize=9)\n",
    "    ax.set_yticks([0.3, 1.3]); ax.set_yticklabels(['Low Median\\nConvention', 'High Median\\nConvention'], fontsize=9)\n",
    "    ax.set_zlabel(zlabel, fontsize=12); ax.set_title(title, fontsize=11); ax.view_init(20, -45)\n",
    "    for pane in (ax.xaxis, ax.yaxis, ax.zaxis): pane.pane.fill = False\n",
    "    plt.tight_layout(); V.save('19')\n",
    "    print(title, '-> hit prob per cell:', {f'{a}|{b}': round(p, 4) for (a, b), p in P4.items()})"
   ]
  },
