       "0   19.0           2.0  ...      NaN             Instruments        0.876676   \n",
       "1    0.0           0.0  ...      1.0  Mechanical engineering        0.528235   \n",
       "2    0.0           0.0  ...      6.0               Chemistry        0.000024   \n",
       "\n",
       "   pctl_uniqueC_5  pctl_uniqueC_10  pctl_uniqueC_all      SB_B  SB_T  n_cite  \\\n",
