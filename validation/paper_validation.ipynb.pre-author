      "Earth and Planetary Sciences                    0.3260   23501\n",
      "Medicine                                        0.3421   55189\n",
      "Chemical Engineering                            0.3447    3112\n",
      "Physics and Astronomy                           0.3455   35942\n",
      "Immunology and Microbiology                     0.3487    3389\n",
      "Biochemistry, Genetics and Molecular Biology    0.3533   27441\n",
      "Materials Science                               0.3562   16887\n",
      "Pharmacology, Toxicology and Pharmaceutics      0.3596    1665\n",
      "Chemistry                                       0.3610   23735\n",
