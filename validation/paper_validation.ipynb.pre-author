    "        a.set_xscale('symlog', linthresh=1); a.set_yscale('log')\n",
    "        a.axvline(0, color='k', lw=0.8)\n",
    "        a.set_title(f'{c}  (median {v.median():+.2f})'); a.set_xlabel(f'{c} (symlog)')\n",
