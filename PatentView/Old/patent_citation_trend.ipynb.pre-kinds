   "source": [
    "%%time\n",
    "def pivot_long(long_df, ex, nx):\n",
    "    p = long_df.pivot_table(index=['cited', 'cite_year'], columns='bucket', values='n', fill_value=0).reset_index()\n",
    "    for b in ['examiner', 'non_examiner']:\n",
    "        if b not in p.columns: p[b] = 0\n",
    "    return p.rename(columns={'examiner': ex, 'non_examiner': nx})[['cited', 'cite_year', ex, nx]]\n",
    "\n",
    "pg = pivot_long(pat, 'pat2pat_examiner', 'pat2pat_non_examiner')\n",
    "pa = pivot_long(patapp, 'app2pat_examiner', 'app2pat_non_examiner')\n",
    "allt = pg.merge(pa, on=['cited', 'cite_year'], how='outer')\n",
    "valcols = ['pat2pat_examiner', 'pat2pat_non_examiner', 'app2pat_examiner', 'app2pat_non_examiner']\n",
    "for c in valcols: allt[c] = allt[c].fillna(0).astype('int64')\n",
    "allt = allt.rename(columns={'cited': 'patent_id'})\n",
    "allt['grant_year'] = allt['patent_id'].map(pid2year)\n",
    "allt = allt.dropna(subset=['grant_year'])\n",
    "allt['grant_year'] = allt['grant_year'].astype(int); allt['cite_year'] = allt['cite_year'].astype(int)\n",
    "allt = allt[allt['cite_year'] >= allt['grant_year']]\n",
    "allt['yrs_since_grant'] = allt['cite_year'] - allt['grant_year']\n",
    "allt = allt[['patent_id', 'grant_year', 'cite_year', 'yrs_since_grant'] + valcols]\n",
    "allt.to_parquet(OUT_FP, index=False)\n",
    "print(f'WROTE {OUT_FP}  ({len(allt):,} rows)')\n",
    "gs = allt['pat2pat_examiner'].sum() + allt['pat2pat_non_examiner'].sum()\n",
    "asum = allt['app2pat_examiner'].sum() + allt['app2pat_non_examiner'].sum()\n",
    "print(f'  patents covered: {allt.patent_id.nunique():,}')\n",
    "print(f'  granted p2p total: {gs:,} (examiner {allt.pat2pat_examiner.sum()/gs*100:.1f}%)')\n",
    "print(f'  application p2p total: {asum:,} (examiner {allt.app2pat_examiner.sum()/max(asum,1)*100:.1f}%)')\n",
    "display(allt.head(8))"
   ]
  }
 ],
