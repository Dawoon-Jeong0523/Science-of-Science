    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "ROOT: C:\\Users\\jdwoo\\OneDrive\\Desktop\\Research\\Science of Science\n"
     ]
    }
   ],
   "source": [
    "import os, sys, gc, time\n",
    "import numpy as np, pandas as pd\n",
    "sys.path.insert(0, '/project/jevans/Dawoon/Science of Science/PatentView')\n",
    "import pv_common as pv\n",
    "ROOT, D, OUT = pv.BASE, pv.GRANTED, pv.OUT\n",
    "POUT = pv.OUT\n",
    "OUT_FP = pv.out('patent_hit_probability.parquet')\n",
    "pv.preflight('patent_hit_probability')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "d45fb701",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-27T19:43:15.023328Z",
     "iopub.status.busy": "2026-08-27T19:43:15.023328Z",
     "iopub.status.idle": "2026-08-27T19:43:15.025802Z",
     "shell.execute_reply": "2026-08-27T19:43:15.025802Z"
    }
   },
   "outputs": [],
   "source": [
    "WINS = [('c3', 'C_3'), ('c5', 'C_5'), ('c10', 'C_10'), ('call', 'C_all')]\n",
    "def add_percentile(df, cohort_cols):\n",
    "    \"\"\"Within each cohort partition, the citation PERCENTILE per window in [0, 1]\n",
    "    (higher = more cited). rank(ascending=True, method='min') puts zero-citation ties near 0 and the\n",
    "    top near 1; e.g. top 1% / 5% / 10% correspond to pctl >= 0.99 / 0.95 / 0.90.\"\"\"\n",
    "    for wtag, wcol in WINS:\n",
    "        df[f'pctl_{wtag}'] = df.groupby(cohort_cols)[wcol].rank(pct=True, ascending=True, method='min').astype('float32')\n",
    "    return df"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d0b3e3d9",
   "metadata": {},
   "source": [
    "## 1. Load citations + grant year + WIPO sector"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "09bf1aaa",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-27T19:43:15.026804Z",
     "iopub.status.busy": "2026-08-27T19:43:15.026804Z",
     "iopub.status.idle": "2026-08-27T19:43:43.196696Z",
     "shell.execute_reply": "2026-08-27T19:43:43.196696Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "patents with sector: 8,512,715\n",
      "CPU times: total: 27.5 s\n",
      "Wall time: 28.2 s\n"
     ]
    }
   ],
   "source": [
    "%%time\n",
    "cit = pd.read_parquet(os.path.join(POUT, 'patent_citation.parquet'), columns=['patent_id', 'C_3', 'C_5', 'C_10', 'C_all'])\n",
    "yr = pd.read_parquet(os.path.join(POUT, 'patent_metadata.parquet'), columns=['patent_id', 'grant_year'])\n",
    "wp = pd.read_csv(os.path.join(D, 'g_wipo_technology.tsv.zip'), sep='\\t',\n",
    "                 usecols=['patent_id', 'wipo_field_sequence', 'wipo_sector_title'],\n",
    "                 dtype={'patent_id': str, 'wipo_sector_title': str})\n",
    "wp['wipo_field_sequence'] = pd.to_numeric(wp['wipo_field_sequence'], errors='coerce')\n",
    "sector = (wp.sort_values(['patent_id', 'wipo_field_sequence']).drop_duplicates('patent_id', keep='first')\n",
    "            .set_index('patent_id')['wipo_sector_title'].rename('wipo_sector'))\n",
    "df = yr.merge(cit, on='patent_id', how='left').merge(sector, left_on='patent_id', right_index=True, how='left')\n",
    "for c in ['C_3', 'C_5', 'C_10', 'C_all']:\n",
    "    df[c] = df[c].fillna(0).astype('int64')\n",
    "df = df.dropna(subset=['wipo_sector'])\n",
    "print(f'patents with sector: {len(df):,}'); del cit, yr, wp"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b7bef36e",
   "metadata": {},
   "source": [
