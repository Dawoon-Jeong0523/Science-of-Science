ext": ["\r", "atypicality by year (cumulative):  42%|\u2588\u2588\u2588\u2588\u258f     | 21/50 [00:28<00:52,  1.80s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  44%|\u2588\u2588\u2588\u2588\u258d     | 22/50 [00:30<00:52,  1.87s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  46%|\u2588\u2588\u2588\u2588\u258c     | 23/50 [00:32<00:55,  2.06s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  48%|\u2588\u2588\u2588\u2588\u258a     | 24/50 [00:35<00:58,  2.26s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  50%|\u2588\u2588\u2588\u2588\u2588     | 25/50 [00:38<01:00,  2.40s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  52%|\u2588\u2588\u2588\u2588\u2588\u258f    | 26/50 [00:41<01:01,  2.55s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  54%|\u2588\u2588\u2588\u2588\u2588\u258d    | 27/50 [00:44<01:02,  2.70s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  56%|\u2588\u2588\u2588\u2588\u2588\u258c    | 28/50 [00:47<01:01,  2.78s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  58%|\u2588\u2588\u2588\u2588\u2588\u258a    | 29/50 [00:49<00:58,  2.79s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  60%|\u2588\u2588\u2588\u2588\u2588\u2588    | 30/50 [00:52<00:54,  2.72s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  62%|\u2588\u2588\u2588\u2588\u2588\u2588\u258f   | 31/50 [00:55<00:53,  2.79s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  64%|\u2588\u2588\u2588\u2588\u2588\