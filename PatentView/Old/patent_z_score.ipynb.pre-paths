 86%|\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u258c | 43/50 [01:59<00:50,  7.28s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  88%|\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u258a | 44/50 [02:09<00:48,  8.09s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  90%|\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588 | 45/50 [02:20<00:43,  8.77s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  92%|\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u258f| 46/50 [02:29<00:36,  9.10s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  94%|\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u258d| 47/50 [02:39<00:27,  9.22s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  96%|\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u258c| 48/50 [02:48<00:18,  9.15s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative):  98%|\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u258a| 49/50 [02:57<00:09,  9.20s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative): 100%|\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588| 50/50 [03:06<00:00,  9.10s/it]"]}, {"name": "stderr", "output_type": "stream", "text": ["\r", "atypicality by year (cumulative): 100%|\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588| 50/50 [03:06<00:00,  3.73s/it]"]}, {"name": "stdout", "output_type": "stream", "text": ["patents scored: 4,160,856  |  (pair, year) rows: 981,662\n", "CPU times: total: 3min 5s\n", "Wall time: 3min 7s\n"]}, {"name": "stderr", "output_type": "stream", "text": ["\n"]}], "source": ["%%time\n", "by_year = defaultdict(list)\n", "for pid in code_set:\n", "    by_year[year_of[pid]].append(pid)\n", "\n", "N = 0\n", "n_code = defaultdict(int); o_pair = defaultdict(int)\n", "work_rows = []; pair_rows = []\n", "for y in tqdm(sorted(by_year), desc='atypicality by year (cumulative)'):\n", "    pats = by_year[y]\n", "    for pid in pats:                                   # extend the cumulative set P(t)\n", "        S = code_set[pid]; N += 1\n", "        for c in S: n_code[c] += 1\n", "        for a, b in combinations(S, 2): o_pair[(a, b)] += 1\n", "    invN = 1.0 / N\n", "    zmap = {}\n", "    for pid in pats:                                   # score this year's patents vs cumulative null\n", "        zs = []\n", "        for a, b in combinations(code_set[pid], 2):\n", "            na = n_code[a]; nb = n_code[b]; mu = na * nb * invN\n", "            var = mu * (1 - na * invN) * ((N - nb) / (N - 1)) if N > 1 else 0.0\n", "            z = (o_pair[(a, b)] - mu) / sqrt(var) if var > 0 else 0.0\n", "            zs.append(z)\n", "            if (a, b) not in zmap: zmap[(a, b)] = z\n", "        arr = np.asarray(zs)\n", "        work_rows.append((pid, float(np.median(arr)), float(np.percentile(arr, 10)), float(arr.min()), len(arr)))\n", "    for (a, b), z in zmap.items():\n", "        pair_rows.append((a, b, y, z))\n", "print(f'patents scored: {len(work_rows):,}  |  (pair, year) rows: {len(pair_rows):,}')"]}, {"cell_type": "markdown", "id": "332b94d9", "metadata": {}, "source": ["## 3. Save both outputs + example"]}, {"cell_type": "code", "execution_count": 4, "id": "2cfd5f53", "metadata": {"execution": {"iopub.execute_input": "2026-08-26T21:57:44.006559Z", "iopub.status.busy": "2026-08-26T21:57:44.006559Z", "iopub.status.idle": "2026-08-26T21:57:46.535089Z", "shell.execute_reply": "2026-08-26T21:57:46.535089Z"}}, "outputs": [{"name": "stdout", "output_type": "stream", "text": ["WROTE patent_z_score.parquet (4,160,856 rows) + z_score_pair.parquet (981,662 rows)\n"]}, {"data": {"text/html": ["<div>\n", "<style scoped>\n", "    .dataframe tbody tr th:only-of-