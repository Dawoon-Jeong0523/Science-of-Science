   "source": [
    "import os, sys, gc, time\n",
    "import numpy as np, pandas as pd\n",
    "sys.path.insert(0, '/project/jevans/Dawoon/Science of Science/PatentView')\n",
    "import pv_common as pv\n",
    "ROOT, D, OUT = pv.BASE, pv.GRANTED, pv.OUT\n",
    "OUT_FP = pv.out('patent_citation.parquet')\n",
    "WINSFX = [(3, '_3'), (5, '_5'), (10, '_10'), (-1, '_all')]\n",
    "XWALK = pv.pregranted('pg_granted_pgpubs_crosswalk.tsv.zip')   # arrived 2026-08-28\n",
    "pv.preflight('patent_citation')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cfb8246f",
   "metadata": {},
   "source": [
    "## 1. Grant years (utility)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "fcba10fa",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T20:17:08.787207Z",
     "iopub.status.busy": "2026-08-28T20:17:08.787207Z",
     "iopub.status.idle": "2026-08-28T20:17:18.834920Z",
     "shell.execute_reply": "2026-08-28T20:17:18.834920Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "utility patents: 8,531,961\n",
      "CPU times: total: 9.88 s\n",
      "Wall time: 10 s\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "22"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "%%time\n",
    "gp = pd.read_csv(os.path.join(D, 'g_patent.tsv.zip'), sep='\\t',\n",
    "                 usecols=['patent_id', 'patent_type', 'patent_date'], dtype={'patent_id': str, 'patent_type': str})\n",
    "gp = gp[gp['patent_type'] == 'utility']\n",
    "gp['grant_year'] = pd.to_datetime(gp['patent_date'], errors='coerce').dt.year\n",
    "gp = gp.dropna(subset=['grant_year']); pid2year = dict(zip(gp['patent_id'], gp['grant_year'].astype(int)))\n",
    "print(f'utility patents: {len(pid2year):,}'); del gp; gc.collect()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "dd05661d",
   "metadata": {},
   "source": [
    "## 2. Scan citations \u2192 per-(cited, window, bucket) counts"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "6db410e8",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T20:17:18.835922Z",
     "iopub.status.busy": "2026-08-28T20:17:18.835922Z",
     "iopub.status.idle": "2026-08-28T20:26:25.266325Z",
     "shell.execute_reply": "2026-08-28T20:26:25.266325Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[546s] scanned 152,626,482 rows. citation_category breakdown:\n",
      "    cited by applicant                         73,526,002  48.172%\n",
      "    cited by examiner                          31,766,814  20.813%\n",
      "    cited by other                             25,440,390  16.668%\n",
      "    <null>                                     21,850,655  14.316%\n",
      "    imported from a related application            42,621   0.028%\n",
      "    cited by third party                            5,426   0.004%\n",
      "CPU times: total: 8min 58s\n",
      "Wall time: 9min 6s\n"
     ]
    }
   ],
   "source": [
    "%%time\n",
    "# Provenance: examiner / non-examiner (applicant + other) / unknown (NULL, pre-2001, no origin info).\n",
    "# \"cited by third party\" (AIA pre-issuance submissions) is EXCLUDED from all counts.\n",
    "from collections import Counter\n",
    "catcnt = Counter()\n",
    "acc = {sfx: [] for _, sfx in WINSFX}\n",
    "t0 = time.time(); seen = 0\n",
    "for ch in pd.read_csv(os.path.join(D, 'g_us_patent_citation.tsv.zip'), sep='\\t',\n",
    "                      usecols=['patent_id', 'citation_patent_id', 'citation_category'], dtype=str, chunksize=5_000_000):\n",
    "    ch = ch.dropna(subset=['citation_patent_id'])\n",
    "    cat = ch['citation_category'].fillna('').str.lower()\n",
    "    for k, v in cat.replace('', '<null>').value_counts().items(): catcnt[k] += int(v)\n",
    "    notp = ~cat.str.contains('third party', na=False)     # drop third-party citations entirely\n",
    "    ch = ch.loc[notp]; cat = cat.loc[notp]\n",
    "    cy = ch['patent_id'].map(pid2year); dy = ch['citation_patent_id'].map(pid2year)\n",
    "    keep = (cy.notna() & dy.notna()).values\n",
    "    if keep.any():\n",
    "        diff = (cy.values - dy.values)[keep]\n",
    "        cited = ch['citation_patent_id'].values[keep]\n",
    "        cv = cat.values[keep]\n",
    "        bucket = np.where(cv == 'cited by examiner', 'examiner',\n",
    "                          np.where(cv == '', 'unknown', 'non_examiner'))\n",
    "        pos = diff >= 0\n",
    "        base = pd.DataFrame({'cited': cited[pos], 'bucket': bucket[pos], 'diff': diff[pos]})\n",
    "        for w, sfx in WINSFX:\n",
    "            sub = base if w == -1 else base[base['diff'] <= w]\n",
    "            if len(sub):\n",
    "                acc[sfx].append(sub.groupby(['cited', 'bucket']).size().reset_index(name='n'))\n",
    "    seen += len(ch)\n",
    "tot = sum(catcnt.values())\n",
    "print(f'[{time.time()-t0:.0f}s] scanned {seen:,} rows. citation_category breakdown:')\n",
    "for k, v in catcnt.most_common(): print(f'    {k:40s} {v:>12,}  {v/tot*100:6.3f}%')"
   ]
  },
  {
