   "source": [
    "%%time\n",
    "outapp = None\n",
    "for w, sfx in WINSFX:\n",
    "    if not acc_app[sfx]: continue\n",
    "    d = (pd.concat(acc_app[sfx], ignore_index=True).groupby(['cited', 'bucket'])['n'].sum()\n",
    "           .unstack('bucket').fillna(0).astype('int64'))\n",
    "    for b in ['examiner', 'non_examiner']:\n",
    "        if b not in d.columns: d[b] = 0\n",
    "    d = d[['examiner', 'non_examiner']]\n",
    "    d.columns = [f'appC_examiner{sfx}', f'appC_non_examiner{sfx}']\n",
    "    d[f'appC{sfx}'] = d.sum(axis=1)\n",
    "    outapp = d if outapp is None else outapp.join(d, how='outer')\n",
    "outapp = outapp.fillna(0).astype('int64').reset_index().rename(columns={'cited': 'patent_id'})\n",
    "appcols = [f'appC{s}' for _, s in WINSFX] + \\\n",
    "          [f'appC_{k}{s}' for _, s in WINSFX for k in ['examiner', 'non_examiner']]\n",
    "outapp = outapp[['patent_id'] + appcols]\n",
    "\n",
    "prev = pd.read_parquet(OUT_FP)\n",
    "gcols = [c for c in prev.columns if c != 'patent_id']\n",
    "merged = prev.merge(outapp, on='patent_id', how='outer')\n",
    "for c in gcols + appcols: merged[c] = merged[c].fillna(0).astype('int64')\n",
    "merged.to_parquet(OUT_FP, index=False)\n",
    "print(f'WROTE {OUT_FP}  ({len(merged):,} rows, {len(merged.columns)} cols; +{len(appcols)} app-citation cols)')\n",
    "for _, s in WINSFX:\n",
    "    print(f'  appC{s}: mean {merged[f\"appC{s}\"].mean():.3f}  exm/non-exm means '\n",
    "          f'{merged[f\"appC_examiner{s}\"].mean():.3f}/{merged[f\"appC_non_examiner{s}\"].mean():.3f}')\n",
    "display(merged.head(5))"
   ]
  }
