   "source": [
    "%%time\n",
    "out = None\n",
    "for w, sfx in WINSFX:\n",
    "    d = (pd.concat(acc[sfx], ignore_index=True).groupby(['cited', 'bucket'])['n'].sum()\n",
    "           .unstack('bucket').fillna(0).astype('int64'))\n",
    "    for b in ['examiner', 'non_examiner', 'unknown']:\n",
    "        if b not in d.columns: d[b] = 0\n",
    "    d = d[['examiner', 'non_examiner', 'unknown']]\n",
    "    d.columns = [f'C_examiner{sfx}', f'C_non_examiner{sfx}', f'C_unknown{sfx}']\n",
    "    d[f'C{sfx}'] = d.sum(axis=1)\n",
    "    out = d if out is None else out.join(d, how='outer')\n",
    "out = out.fillna(0).astype('int64').reset_index().rename(columns={'cited': 'patent_id'})\n",
    "cols = ['patent_id'] + [f'C{s}' for _, s in WINSFX] + \\\n",
    "       [f'C_{k}{s}' for _, s in WINSFX for k in ['examiner', 'non_examiner', 'unknown']]\n",
    "out = out[cols]\n",
    "out.to_parquet(OUT_FP, index=False)\n",
    "print(f'WROTE {OUT_FP}  ({len(out):,} rows, {len(out.columns)} cols)')\n",
    "for _, s in WINSFX:\n",
    "    print(f'  C{s}: mean {out[f\"C{s}\"].mean():.2f}  exm/non-exm/unk means '\n",
    "          f'{out[f\"C_examiner{s}\"].mean():.2f}/{out[f\"C_non_examiner{s}\"].mean():.2f}/{out[f\"C_unknown{s}\"].mean():.3f}')\n",
    "display(out.head(10))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b571bbb9",
   "metadata": {},
   "source": [
    "## Application citations (forward, from `g_us_application_citation`)\n",
    "\n",
    "Citations a patent receives **at the application (pre-grant) stage**. The cited entity in `g_us_application_citation` is a **pre-grant publication number** (`citation_document_number` = pgpub_id), mapped to a granted `patent_id` via `pg_granted_pgpubs_crosswalk` (pgpub_id -> patent_id). Coverage: ~68.4% of application-citation rows map to a granted patent (the rest cite never-granted apps).\n",
    "\n",
    "Same conventions as granted citations: provenance **examiner** / **non_examiner** (applicant + other + imported-from-related-application); **cited by third party is excluded**. Windows use `citing_grant_year - cited_grant_year` (>= 0), suffixes `_3/_5/_10/_all`. Application citations carry no NULL category, so there is no `unknown` bucket here. New columns: `appC{_w}`, `appC_examiner{_w}`, `appC_non_examiner{_w}`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "4572ed13",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T20:27:29.854753Z",
     "iopub.status.busy": "2026-08-28T20:27:29.854753Z",
     "iopub.status.idle": "2026-08-28T20:35:24.028980Z",
     "shell.execute_reply": "2026-08-28T20:35:24.028980Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "crosswalk pgpub->patent pairs: 5,432,615\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[464s] scanned 78,557,720 app-citation rows. category breakdown:\n",
      "    cited by applicant                         52,713,430  67.097%\n",
      "    cited by examiner                          20,733,176  26.391%\n",
      "    cited by other                              5,086,377   6.474%\n",
      "    imported from a related application            24,737   0.031%\n",
      "    cited by third party                            4,824   0.006%\n",
      "CPU times: total: 7min 45s\n",
      "Wall time: 7min 54s\n"
     ]
    }
   ],
   "source": [
    "%%time\n",
    "from collections import Counter\n",
    "XW = XWALK\n",
    "xw = pd.read_csv(XW, sep='\\t', usecols=['pgpub_id', 'patent_id'], dtype=str, on_bad_lines='skip')\n",
    "xw = xw.dropna(subset=['pgpub_id', 'patent_id']).drop_duplicates('pgpub_id')\n",
    "pgpub2pid = dict(zip(xw['pgpub_id'], xw['patent_id'])); del xw; gc.collect()\n",
    "print(f'crosswalk pgpub->patent pairs: {len(pgpub2pid):,}')\n",
    "\n",
    "AC = os.path.join(D, 'g_us_application_citation.tsv.zip')\n",
    "appcat = Counter(); acc_app = {sfx: [] for _, sfx in WINSFX}\n",
    "t0 = time.time(); seen = 0\n",
    "for ch in pd.read_csv(AC, sep='\\t', usecols=['patent_id', 'citation_document_number', 'citation_category'],\n",
    "                      dtype=str, chunksize=5_000_000, on_bad_lines='skip'):\n",
    "    ch = ch.dropna(subset=['citation_document_number', 'patent_id'])\n",
    "    cat = ch['citation_category'].fillna('').str.lower()\n",
    "    for k, v in cat.replace('', '<null>').value_counts().items(): appcat[k] += int(v)\n",
    "    notp = ~cat.str.contains('third party', na=False)      # drop third-party citations entirely\n",
    "    ch = ch.loc[notp]; cat = cat.loc[notp]\n",
    "    cited = ch['citation_document_number'].map(pgpub2pid)   # cited granted patent_id (via crosswalk)\n",
    "    cy = ch['patent_id'].map(pid2year)                      # citing patent grant year\n",
    "    dy = cited.map(pid2year)                                # cited patent grant year\n",
    "    keep = (cited.notna() & cy.notna() & dy.notna()).values\n",
    "    if keep.any():\n",
    "        diff = (cy.values - dy.values)[keep]\n",
    "        cc = cited.values[keep]; cv = cat.values[keep]\n",
    "        bucket = np.where(cv == 'cited by examiner', 'examiner', 'non_examiner')\n",
    "        pos = diff >= 0\n",
    "        base = pd.DataFrame({'cited': cc[pos], 'bucket': bucket[pos], 'diff': diff[pos]})\n",
    "        for w, sfx in WINSFX:\n",
    "            sub = base if w == -1 else base[base['diff'] <= w]\n",
    "            if len(sub):\n",
    "                acc_app[sfx].append(sub.groupby(['cited', 'bucket']).size().reset_index(name='n'))\n",
    "    seen += len(ch)\n",
    "tot = sum(appcat.values())\n",
    "print(f'[{time.time()-t0:.0f}s] scanned {seen:,} app-citation rows. category breakdown:')\n",
    "for k, v in appcat.most_common(): print(f'    {k:40s} {v:>12,}  {v/tot*100:6.3f}%')"
   ]
  },
