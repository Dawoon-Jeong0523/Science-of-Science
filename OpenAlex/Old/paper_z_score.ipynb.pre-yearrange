    "## 2. Uzzi atypicality engine — code space, one focal-year cohort at a time"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d5f33465",
   "metadata": {},
   "outputs": [],
   "source": [
    "import random\n",
    "from itertools import combinations\n",
    "from collections import defaultdict\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "\n",
    "def _sample_without_replacement(rng, n, k):\n",
    "    \"\"\"k distinct indices out of n, in O(k) rather than O(n).\n",
    "\n",
    "    np.random.choice(replace=False) permutes the whole population, which is unaffordable when\n",
    "    a donor pool holds tens of millions of edges and only a few thousand slots are drawn.\n",
    "    Partial Fisher-Yates on a dict gives the same distribution at the size actually needed.\"\"\"\n",
    "    if k >= n:\n",
    "        return np.arange(n)\n",
    "    swap = {}\n",
    "    out = np.empty(k, np.int64)\n",
    "    for i in range(k):\n",
    "        j = int(rng.integers(i, n))\n",
    "        out[i] = swap.get(j, j)\n",
    "        swap[j] = swap.get(i, i)\n",
    "    return out\n",
    "\n",
    "\n",
    "def atypicality_mag(focal_codes, year, out_ptr, out_idx, journal_by_code,\n",
    "                    num_shuffles=10, min_refs=2, max_refs=1000, seed=42, verbose=True):\n",
    "    \"\"\"Uzzi atypicality, following MAG-Atyp-Comb-1990-2000.ipynb.\n",
    "\n",
    "    Two things differ from the earlier implementation in this notebook, and both change the\n",
    "    numbers rather than just the speed:\n",
    "\n",
    "    1. THE NULL'S DONOR POOL IS THE WHOLE (citing year, cited year) CELL, not the focal\n",
    "       cohort. The reference builds D[(citing_year, cited_year)] over EVERY citing paper of\n",
    "       that year and shuffles the cited column inside it, so a focal paper's counterfactual\n",
    "       references are drawn from everything published in the cited year that anyone citing in\n",
    "       that year referenced -- including the references of non-journal papers, and including\n",
    "       cited papers that carry no journal. Shuffling only within the cohort, as before, makes\n",
    "       the null a statement about the cohort instead of about the literature.\n",
    "\n",
    "       Materialising that permutation is impossible here: the snapshot has ~2.2e9 edges\n",
    "       against the reference's decade of MAG. It is not needed. A uniform permutation of a\n",
    "       cell's cited column is exchangeable, so the slots belonging to focal papers are a\n",
    "       simple random sample WITHOUT replacement from that cell's cited pool. Drawing only\n",
    "       those slots is exact, not an approximation.\n",
    "\n",
    "    2. PAIRS ARE COUNTED WITH MULTIPLICITY. `cal_J` in the reference increments the (J_i, J_j)\n",
    "       counter for every i<j pair of references, so a paper citing three papers in journal A\n",
    "       and two in journal B contributes 6 to (A, B), not 1. The null is counted the same way,\n",
    "       so the z-score is on a consistent scale. The per-paper aggregate still uses the\n",
    "       DISTINCT pairs the paper touches (`Paper_pair` is a set there), which is why a paper's\n",
    "       n_pairs is far smaller than its contribution to the counters.\n",
    "\n",
    "    Kept from the reference: 10 shuffles, papers with more than `max_refs` references skipped,\n",
    "    journal pairs whose null standard deviation is zero dropped, and per-paper median and 10th\n",
    "    percentile of the z of its distinct pairs.\n",
    "\n",
    "    Returns (work_df[code, Z_median, Z_10pct, Z_min, n_pairs], pair_df[code_1, code_2, year, Z_score]).\n",
    "    \"\"\"\n",
    "    rng = np.random.default_rng(seed)\n",
    "    n = len(year)\n",
    "    fy = year[focal_codes]\n",
    "    order = np.argsort(fy, kind='stable')\n",
    "    fc, fys = focal_codes[order], fy[order]\n",
    "    uyears, starts = np.unique(fys, return_index=True)\n",
    "    bounds = list(starts) + [len(fc)]\n",
    "\n",
    "    # Papers grouped by publication year, so a citing-year cell can be assembled without\n",
    "    # scanning the whole snapshot once per year.\n",
    "    yorder = np.argsort(year, kind='stable')\n",
    "    ysorted = year[yorder]\n",
    "    uy, ustart = np.unique(ysorted, return_index=True)\n",
    "    uend = list(ustart[1:]) + [len(ysorted)]\n",
    "    ystart = {int(y): (int(a), int(b)) for y, a, b in zip(uy, ustart, uend)}\n",
    "\n",
    "    work_rows, pair_rows = [], []\n",
    "    for gi in tqdm(range(len(uyears)), desc='atypicality by year', disable=not verbose):\n",
    "        cy = int(uyears[gi])\n",
    "        grp = fc[bounds[gi]:bounds[gi + 1]]\n",
    "        if cy not in ystart:\n",
    "            continue\n",
    "\n",
    "        # ---- the donor pools: every edge whose citing paper was published in cy ----------\n",
    "        s, e = ystart[cy]\n",
    "        citing_all = yorder[s:e]\n",
    "        seg = [out_idx[out_ptr[p]:out_ptr[p + 1]] for p in citing_all.tolist()]\n",
    "        seg = [x for x in seg if len(x)]\n",
    "        if not seg:\n",
    "            continue\n",
    "        dst = np.concatenate(seg)\n",
    "        del seg\n",
    "        dy_all = year[dst]\n",
    "        o = np.argsort(dy_all, kind='stable')\n",
    "        dst, dy_all = dst[o], dy_all[o]\n",
    "        du, dstart = np.unique(dy_all, return_index=True)\n",
    "        dend = list(dstart[1:]) + [len(dst)]\n",
    "        pool = {int(y): dst[a:b] for y, a, b in zip(du, dstart, dend)}\n",
    "        del dst, dy_all, o, du, dstart, dend\n",
    "        gc.collect()\n",
    "\n",
    "        # ---- the focal papers of this year, with their references and cited years --------\n",
    "        cohort = []\n",
    "        for F in grp.tolist():\n",
    "            a0, a1 = out_ptr[F], out_ptr[F + 1]\n",
    "            k = a1 - a0\n",
    "            if k < min_refs or k > max_refs:      # the reference skips >1000 outright\n",
    "                continue\n",
    "            refs = out_idx[a0:a1]\n",
    "            cohort.append((F, refs, year[refs]))\n",
    "        if not cohort:\n",
    "            continue\n",
    "\n",
    "        # ---- observed: every i<j pair, with multiplicity; distinct pairs per paper --------\n",
    "        obs = defaultdict(int)\n",
    "        work_pairs = {}\n",
    "        for F, refs, _ in cohort:\n",
    "            jc = journal_by_code[refs]\n",
    "            jc = jc[jc >= 0]\n",
    "            if len(jc) < 2:\n",
    "                continue\n",
    "            seen = set()\n",
    "            for a, b in combinations(jc.tolist(), 2):\n",
    "                p = (a, b) if a <= b else (b, a)\n",
    "                obs[p] += 1\n",
    "                seen.add(p)\n",
    "            work_pairs[F] = seen\n",
    "        if not obs:\n",
    "            continue\n",
    "\n",
    "        # ---- null: draw each paper's slots from the (cy, dy) pool, without replacement ----\n",
    "        null_counts = []\n",
    "        for _ in range(num_shuffles):\n",
    "            ec = defaultdict(int)\n",
    "            need = defaultdict(list)              # cited-year -> [(paper index, how many)]\n",
    "            for i, (F, refs, dys) in enumerate(cohort):\n",
    "                if F not in work_pairs:\n",
    "                    continue\n",
    "                u, c = np.unique(dys, return_counts=True)\n",
    "                for yy, cc in zip(u.tolist(), c.tolist()):\n",
    "                    need[yy].append((i, cc))\n",
    "            drawn = {i: [] for i in range(len(cohort))}\n",
    "            for yy, reqs in need.items():\n",
    "                p = pool.get(yy)\n",
    "                if p is None or not len(p):\n",
    "                    continue\n",
    "                tot = sum(c for _, c in reqs)\n",
    "                idx = _sample_without_replacement(rng, len(p), tot)\n",
    "                take = p[idx]\n",
    "                off = 0\n",
    "                for i, c in reqs:\n",
    "                    drawn[i].append(take[off:off + c]); off += c\n",
    "            for i, (F, refs, _) in enumerate(cohort):\n",
    "                if F not in work_pairs or not drawn[i]:\n",
    "                    continue\n",
    "                sub = np.concatenate(drawn[i])\n",
    "                jc = journal_by_code[sub]\n",
    "                jc = jc[jc >= 0]\n",
    "                if len(jc) < 2:\n",
    "                    continue\n",
    "                for a, b in combinations(jc.tolist(), 2):\n",
    "                    ec[(a, b) if a <= b else (b, a)] += 1\n",
    "            null_counts.append(ec)\n",
    "\n",
    "        # ---- z per journal pair; the reference drops std == 0 rather than smoothing -------\n",
    "        zmap = {}\n",
    "        for p, o_ in obs.items():\n",
    "            vals = np.array([nc.get(p, 0) for nc in null_counts], float)\n",
    "            mu, sd = vals.mean(), vals.std()\n",
    "            if sd == 0.0:\n",
    "                continue\n",
    "            z = (o_ - mu) / sd\n",
    "            zmap[p] = z\n",
    "            pair_rows.append((p[0], p[1], cy, z))\n",
    "\n",
    "        for F, pairs_ in work_pairs.items():\n",
    "            zs = [zmap[p] for p in pairs_ if p in zmap]\n",
    "            if zs:\n",
    "                arr = np.asarray(zs)\n",
    "                work_rows.append((F, float(np.quantile(arr, .5)), float(np.quantile(arr, .1)),\n",
    "                                  float(arr.min()), len(arr)))\n",
    "        del cohort, obs, work_pairs, null_counts, zmap, pool\n",
    "        gc.collect()\n",
    "\n",
    "    work_df = pd.DataFrame(work_rows,\n",
    "                           columns=['code', 'Z_median', 'Z_10pct', 'Z_min', 'n_pairs'])\n",
    "    pair_df = pd.DataFrame(pair_rows, columns=['code_1', 'code_2', 'year', 'Z_score'])\n",
    "    return work_df, pair_df\n",
    "\n",
    "\n",
    "print('atypicality engine ready — MAG-Atyp-Comb null (cell-wide donor pool, '\n",
    "      'pairs counted with multiplicity)')"
   ]
  },
