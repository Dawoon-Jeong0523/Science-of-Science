    "oa.build_journal()\n",
    "jr = pd.read_parquet(oa.JOURNAL_PQ, columns=['work_id', 'source_id', 'is_journal'])\n",
    "pid = oa.id_to_code(jr['work_id'])\n",
    "sid = oa.id_to_code(jr['source_id'].str.replace('^S', 'W', regex=True))  # S… -> int, same codec\n",
    "isj = jr['is_journal'].fillna(False).to_numpy()\n",
    "ok0 = (pid >= 0) & (sid >= 0)\n",
    "pid, sid, isj = pid[ok0], sid[ok0], isj[ok0]\n",
    "del jr; gc.collect()\n",
    "\n",
    "i = np.searchsorted(uni_mag, pid); i = np.clip(i, 0, n - 1); ok = uni_mag[i] == pid\n",
    "journal_by_code = np.full(n, -1, np.int64); journal_by_code[i[ok]] = sid[ok]\n",
    "is_journal_code = np.zeros(n, np.bool_); is_journal_code[i[ok]] = isj[ok]\n",
    "del pid, sid, isj, i, ok; gc.collect()\n",
    "print(f'papers with journal: {(journal_by_code >= 0).sum():,} | journal-type: {is_journal_code.sum():,}')\n",
    "\n",
    "focal_codes = np.flatnonzero(is_journal_code).astype(np.int64)\n",
    "if YEAR_RANGE is not None:\n",
    "    yy = year[focal_codes]; focal_codes = focal_codes[(yy >= YEAR_RANGE[0]) & (yy <= YEAR_RANGE[1])]\n",
    "print(f'focal journal papers in {YEAR_RANGE}: {len(focal_codes):,}')"
